# Copy to .env.local and fill in the two values from
# Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: absolute origin of the deployed app (used by auth redirects).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the assistant's provider from the environment (wins over the setup wizard and keeps the key
# on the server). AI_PROVIDER is anthropic | openai | google | openai_compatible.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5
# AI_API_KEY=
# AI_BASE_URL=
