# Copy to .env.local and fill in the two values from
# Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: absolute origin of the deployed app (used by auth redirects).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the assistant's provider from the environment (wins over the setup wizard and keeps the key
# on the server). AI_PROVIDER is anthropic | openai | google | openai_compatible.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5
# AI_API_KEY=
# AI_BASE_URL=
# Public citizen assistant: Claude with ANTHROPIC_API_KEY, or AI_API_KEY when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# CITIZEN_AI_MODEL=claude-haiku-5-5

# Optional: the voice line («numero verde») on ElevenLabs Agents. See ../docs/VOICE.md.
# ELEVENLABS_API_KEY and VOICE_TOOL_SECRET are server-only secrets (VOICE_TOOL_SECRET: at least 24 random chars,
# e.g. `openssl rand -hex 32`); the agent id is printed by `node --env-file=.env.local scripts/voice/setup-elevenlabs.mjs`.
# ELEVENLABS_API_KEY=
# VOICE_TOOL_SECRET=
# ELEVENLABS_AGENT_ID=
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# NEXT_PUBLIC_VOICE_NUMBER=
